import os
import subprocess
import re

# உங்கள் கூகுள் டிரைவ் வீடியோ லிங்க்குகள்
video_links = [
    "https://drive.google.com/file/d/1hkKADV8rIPaL-I89-ZzQMgUQuBTE7ECb/view?usp=drivesdk",
    "https://drive.google.com/file/d/1qt12K54QvY6bhI0IUhngi9_rudBYyDxe/view?usp=drivesdk",
    "https://drive.google.com/file/d/1B3J2cpFPB6Uv7Ym61atAGXK-NhBM5Ap4/view?usp=drivesdk",
    "https://drive.google.com/file/d/1H-VSfWm6ZiruBx3ZHbaLBGtCXr6lScrD/view?usp=drivesdk"
]

stream_key = os.environ.get("STREAM_KEY")
rtmp_url = f"rtmp://a.rtmp.youtube.com/live2/{stream_key}"

def extract_id(link):
    match = re.search(r'/d/([a-zA-Z0-9_-]+)', link)
    return match.group(1) if match else None

def download_and_prepare():
    downloaded_files = []
    
    # 1. வீடியோக்களை டவுன்லோட் செய்தல்
    for i, link in enumerate(video_links):
        file_id = extract_id(link)
        if not file_id:
            continue
        output_file = f"video_{i}.mp4"
        print(f"Downloading Video {i+1}...")
        cmd = ["yt-dlp", "-o", output_file, f"https://drive.google.com/uc?id={file_id}"]
        subprocess.run(cmd)
        
        if os.path.exists(output_file):
            # வீடியோவின் அளவை 16:9-க்கு மாற்றி தற்காலிக ஃபைலாக சேமித்தல்
            converted_file = f"ready_{i}.mp4"
            print(f"Converting Video {i+1} to standard format...")
            convert_cmd = [
                "ffmpeg", "-y", "-i", output_file,
                "-vf", "scale=1920:1080:force_original_aspect_ratio=decrease,pad=1920:1080:(ow-iw)/2:(oh-ih)/2:black",
                "-c:v", "libx264", "-preset", "ultrafast", "-pix_fmt", "yuv420p", "-r", "30",
                "-c:a", "aac", "-b:a", "128k", "-ar", "44100",
                converted_file
            ]
            subprocess.run(convert_cmd)
            downloaded_files.append(converted_file)

    # 2. பிளேலிஸ்ட் ஃபைல் உருவாக்குதல் (Concat Text File)
    if downloaded_files:
        with open("playlist.txt", "w") as f:
            for file in downloaded_files:
                f.write(f"file '{file}'\n")
        return True
    return False

def stream_playlist():
    print("Starting continuous live stream from playlist...")
    # Concat demuxer மூலம் அனைத்து வீடியோக்களையும் ஒன்றன் பின் ஒன்றாகத் தொடர்ச்சியாக (Loop-ல்) ஸ்ட்ரீம் செய்தல்
    ffmpeg_cmd = [
        "ffmpeg", "-re", "-f", "concat", "-safe", "0", "-stream_loop", "-1", "-i", "playlist.txt",
        "-c:v", "libx264", "-preset", "veryfast", "-b:v", "3000k",
        "-maxrate", "3000k", "-bufsize", "6000k",
        "-pix_fmt", "yuv420p", "-g", "60",
        "-c:a", "aac", "-b:a", "128k", "-ar", "44100",
        "-f", "flv", rtmp_url
    ]
    subprocess.run(ffmpeg_cmd)

if __name__ == "__main__":
    if download_and_prepare():
        stream_playlist()
