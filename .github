name: Simple YouTube Live Stream

on:
  workflow_dispatch:

jobs:
  stream:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Install Tools
        run: |
          sudo apt-get update
          sudo apt-get install -y ffmpeg python3-pip
          pip3 install gdown

      - name: Download Files Without Errors
        run: |
          # Robust download function handling Google Drive permissions and large files
          dl_drive() {
            FILE_ID=$1
            OUTPUT=$2
            gdown "https://drive.google.com/uc?id=${FILE_ID}" -O "${OUTPUT}" || \
            curl -Lb cookies.txt "https://docs.google.com/uc?export=download&confirm=t&id=${FILE_ID}" -o "${OUTPUT}"
          }

          echo "--- DOWNLOADING ASSETS ---"
          # 1. Video Download
          dl_drive "184Mkv-aOszZ8fzQtD9SL0_8768a5xI2f" "video.mp4"

          # 2. Logo Download (Updated Link)
          dl_drive "1WEu_-Z84_a8jXSsRaL_KBFgiJOTXbqp7" "logo.png"

      - name: Start Live Stream to YouTube
        run: |
          STREAM_KEY="${{ secrets.YOUTUBE_STREAM_KEY }}"
          STREAM_URL="rtmp://a.rtmp.youtube.com/live2"

          # Stream video in a continuous loop with top-left corner logo overlay
          ffmpeg -re \
          -stream_loop -1 -i video.mp4 \
          -i logo.png \
          -filter_complex "[0:v]scale=1280:720:force_original_aspect_ratio=decrease,pad=1280:720:(1280-iw)/2:(720-ih)/2:black,fps=30[scaled];[1:v]scale=80:-1[slogo];[scaled][slogo]overlay=30:30[v]" \
          -map "[v]" -map 0:a? \
          -c:v libx264 -preset ultrafast -b:v 2500k -maxrate 2500k -bufsize 5000k \
          -pix_fmt yuv420p -g 60 \
          -c:a aac -b:a 128k -ar 44100 \
          -f flv "$STREAM_URL/$STREAM_KEY"
